generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum School {
  ENG
  BUS
  ASC
  DES
  HSS
  IIT
}

enum Role {
  Student
  Staff
  Admin
  Bin
}

enum Category {
  MobileApp
  Bins
  Website
  Others
}

enum SubmissionType {
  Feedback
  Reports
}

enum Status {
  Received
  Pending
  Resolved
}

enum BinType {
  General
  Paper
  Plastic
  Metal
  Glass
  Ewaste
}

enum TransactionType {
  BinEarned
  QuestEarned
  Penalty
  Redeemed
}


model User {
  id            String  @id @default(cuid())
  name          String
  email         String  @unique
  emailVerified Boolean @default(false)
  image         String?

  school        School?
  role          Role?
  totalPoints  Int @default(0)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  Bin           Bin?

  accounts      Account[]
  sessions      Session[]
  submission  Submission[]
  questLogs    QuestLog[]
  binUsages    BinUsage[]
  transactions Transaction[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Submission {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  message String
  image String?

  type SubmissionType
  status Status
  category Category

  @@index([userId])
  @@map("Submission")
}

model Quest {
  id String @id @default(cuid())

  awardedPoints Int
  questName String

  description String
  image String?

  questLog QuestLog[]
  @@map("Quest")
}

model QuestLog {
  id String @id @default(cuid())
  questId String
  userId String
  quest Quest @relation(fields: [questId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  completedAt DateTime @default(now())

  transaction Transaction[]

  @@index([questId])
  @@index([userId])
  @@map("QuestLog")
}


model Bin {
  id String @id @default(cuid())
  userId String @unique
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  latitude Float
  longitude Float
  address String

  binUsage BinUsage[]

  @@index([userId])
  @@map("Bin")
}

model BinUsage {
  id String @id @default(cuid())
  binId String
  userId String
  bin Bin @relation(fields: [binId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  weight Float
  type BinType

  transaction Transaction[]

  @@index([binId])
  @@index([userId])
  @@map("BinUsage")
}

model Transaction {
  id String @id @default(cuid())
  userId String
  binUsageId String?
  questLogId String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  binUsage BinUsage? @relation(fields: [binUsageId], references: [id], onDelete: Cascade)
  questLog QuestLog? @relation(fields: [questLogId], references: [id], onDelete: Cascade)

  pointsChanged Int
  
  createdAt DateTime @default(now())
  transactionType TransactionType

  @@index([userId])
  @@index([binUsageId])
  @@index([questLogId])
  @@map("Transaction")
}

